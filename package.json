{
  "name": "quiz-live",
  "private": true,
  "version": "0.0.0",
  "author": "Quiz Team",
  "description": "Application de quiz interactive",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev -- --port 5000\" \"wait-on tcp:5000 && electron .\"",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder"
  },
  "main": "electron-main.js",
  "build": {
    "appId": "quiz.live",
    "productName": "Quiz Live",
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "server.js",
      "services/socket.ts",
      "package.json"
    ],
    "asar": true
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "express": "^5.2.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^40.1.0",
    "electron-builder": "^26.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.3"
  }
}